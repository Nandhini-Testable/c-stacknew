<Project>
  <!--
    Scholarship CMGroups — Roslyn static analysis, PRIMARY tool only
    (Testable_Strategy_Metrics_Mapping_v0.2, Lint / Rule Violations, C# primary "roslyn sast"):
      roslyn-analyzers : Microsoft.CodeAnalysis.NetAnalyzers 8.0.0 (Whitebox_Tools_Registry, C# #1)
    Findings are emitted as build WARNINGS so `dotnet build` passes, and written to SARIF.
    The lint gate (`-p:LintGate=true`) promotes warnings to errors, which FAILS on this
    negative baseline branch by design. Rule severities live in .editorconfig.
  -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AnalysisLevel>8.0</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <ErrorLog>$(MSBuildThisFileDirectory)reports/lint/$(MSBuildProjectName).sarif,version=2.1</ErrorLog>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SecurityCodeScan.VS2019" Version="5.6.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
